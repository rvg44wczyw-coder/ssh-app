# SSH-App (iOS + Rust Core) Makefile
SHELL := /bin/zsh

SCHEME := SSHApp
PROJECT := ios/SSHApp.xcodeproj
BUNDLE_ID := com.semenov.sshapp
CONFIGURATION ?= Release
DERIVED_DATA := $(CURDIR)/.build/DerivedData
APP_PATH := $(DERIVED_DATA)/Build/Products/$(CONFIGURATION)-iphoneos/$(SCHEME).app

# Auto-detect the first connected physical iOS device (arm64) if DEVICE_ID is not passed
DEVICE_ID ?= $(shell xcrun devicectl list devices 2>/dev/null | grep -E "iPhone|00008130" | head -n 1 | grep -oE "[0-9A-F]{8}-[0-9A-F]{16}")

.PHONY: help iphone iphone-full xcframework relay-config ios-build ios-install ios-launch test lint clean tmux-dump

# Куда tmux-dump складывает снимки панелей (вне репозитория).
# TMUX_DUMP_FLAGS=-e сохраняет цвета и стили (escape-последовательности) для разбора разметки.
TMUX_DUMP_FLAGS ?=
TMUX_DUMP_DIR ?= $(or $(TMPDIR),/tmp)/ssh-app-tmux-dump

help:
	@echo "Доступные команды:"
	@echo "  make iphone        — Собрать iOS-приложение, установить и запустить на подключенном iPhone"
	@echo "  make iphone-full   — Пересобрать Rust XCFramework + собрать, установить и запустить на iPhone"
	@echo "  make xcframework   — Собрать Rust Core XCFramework и обновить UniFFI Swift bindings"
	@echo "  make ios-build     — Только скомпилировать и подписать .app для подключенного iPhone"
	@echo "  make ios-install   — Установить собранный .app на подключенный iPhone"
	@echo "  make ios-launch    — Запустить установленное приложение на подключенном iPhone"
	@echo "  make test          — Запустить тесты Rust Core и Swift Bridge"
	@echo "  make lint          — Проверить форматирование и Clippy в Rust Core"
	@echo "  make tmux-dump     — Только читать tmux: сохранить скроллбэк всех панелей в $(TMUX_DUMP_DIR)"
	@echo "  make clean         — Очистить DerivedData"

xcframework:
	./scripts/build-xcframework.sh

# Personal builds only (docs/features/35-push-relay.md, TODO in section 5): the owner's push relay secret is
# read from outside the repo into a git-ignored Swift file so the phone needs no typing. Never ship a
# TestFlight / App Store build made this way; the real fix is per-install App Attest registration.
RELAY_SECRET_FILE ?= $(HOME)/.private_keys/ssh_app_relay_secret
RELAY_CONFIG := ios/Sources/SSHApp/Generated/LocalRelayConfig.swift

relay-config:
	@mkdir -p $(dir $(RELAY_CONFIG))
	@s=""; [ -r "$(RELAY_SECRET_FILE)" ] && s=$$(tr -d '\n\r"\\' < "$(RELAY_SECRET_FILE)"); \
	printf '// Generated by `make relay-config`; git-ignored. Personal builds only.\nenum LocalRelayConfig { static let secret = "%s" }\n' "$$s" > $(RELAY_CONFIG); \
	if [ -n "$$s" ]; then echo "==> relay secret taken from $(RELAY_SECRET_FILE)"; else echo "==> no relay secret file: the app asks for it"; fi

ios-build: relay-config
	@echo "==> Сборка и подпись $(SCHEME) ($(CONFIGURATION)) для iOS..."
	xcodebuild \
		-project $(PROJECT) \
		-scheme $(SCHEME) \
		-configuration $(CONFIGURATION) \
		-destination "generic/platform=iOS" \
		-derivedDataPath $(DERIVED_DATA) \
		-skipPackagePluginValidation \
		-allowProvisioningUpdates \
		-allowProvisioningDeviceRegistration \
		build

ios-install:
	@if [ -z "$(DEVICE_ID)" ]; then \
		echo "Ошибка: подключенный iPhone не найден."; \
		exit 1; \
	fi
	@echo "==> Установка $(APP_PATH) на iPhone ($(DEVICE_ID))..."
	xcrun devicectl device install app --device "$(DEVICE_ID)" "$(APP_PATH)" || ( \
		echo "\n⚠️  Не удалось установить приложение на iPhone ($(DEVICE_ID))."; \
		echo "Убедитесь, что iPhone подключен по кабелю (или в одной сети Wi-Fi), разблокирован и находится в режиме разработчика, затем выполните: make ios-install ios-launch"; \
		exit 1 \
	)

ios-launch:
	@if [ -z "$(DEVICE_ID)" ]; then \
		echo "Ошибка: подключенный iPhone не найден."; \
		exit 1; \
	fi
	@echo "==> Запуск $(BUNDLE_ID) на iPhone ($(DEVICE_ID))..."
	xcrun devicectl device process launch --device "$(DEVICE_ID)" $(BUNDLE_ID)

iphone: ios-build ios-install ios-launch

iphone-full: xcframework iphone

test:
	cargo test -p ssh-core
	swift test --package-path packages/SshCoreBridge

lint:
	cargo fmt --all -- --check
	cargo clippy -p ssh-core -- -D warnings

clean:
	rm -rf $(DERIVED_DATA)

# Читает (и только читает) tmux сервера из $TMUX / по умолчанию: список панелей и полный скроллбэк
# каждой (`capture-pane -p -J -S -`) в файл. Ничего не отправляет в панели и не меняет сервер.
# Нужен для сверки парсера ленты с настоящим экраном агента.
tmux-dump:
	@command -v tmux >/dev/null || { echo "tmux не найден"; exit 1; }
	@tmux has-session 2>/dev/null || { echo "tmux-сервер не запущен"; exit 1; }
	@mkdir -p "$(TMUX_DUMP_DIR)" && chmod 700 "$(TMUX_DUMP_DIR)"
	@tmux list-panes -a -F '#{pane_id}|#{session_name}|#{window_index}|#{pane_index}|#{pane_current_command}|#{pane_width}x#{pane_height}' | \
	while IFS='|' read -r id sess win pane cmd size; do \
		f="$(TMUX_DUMP_DIR)/$$(printf '%s' "$$sess" | tr -c 'A-Za-z0-9._-' '_')_$$win.$$pane.txt"; \
		tmux capture-pane -p -J $(TMUX_DUMP_FLAGS) -S - -t "$$id" > "$$f" 2>/dev/null || continue; \
		printf '%-28s %-10s %-8s %6s строк, рамок-таблиц: %s -> %s\n' "$$sess:$$win.$$pane" "$$cmd" "$$size" "$$(wc -l < "$$f" | tr -d ' ')" "$$(grep -c '┌' "$$f")" "$$f"; \
	done
